{{- $menuItems := slice -}}
{{- $multi := partial "menu/multi-location-enabled.html" . -}}

{{- if $multi -}}
  {{- range site.Sections -}}
    {{- $locSection := . -}}
    {{- $locSlug := .Section -}}
    {{- $isLoc := false -}}
    {{- range site.Data.locations.locations -}}
      {{- if eq .slug $locSlug -}}{{- $isLoc = true -}}{{- end -}}
    {{- end -}}
    {{- if $isLoc -}}
      {{- range $locSection.Sections -}}
        {{- $cat := . -}}
        {{- $secSlug := partial "menu/section-slug.html" $cat -}}
        {{- if and (ne $secSlug "promotions") (not (partial "menu/is-excluded-section.html" $cat.RelPermalink)) -}}
          {{- range $cat.RegularPages -}}
            {{- $menuItems = $menuItems | append (partial "menu/item-dict.html" (dict "page" . "sectionSlug" $secSlug "locationSlug" $locSlug "category" $cat)) -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- else -}}
  {{- range site.Sections -}}
    {{- if not (partial "menu/is-excluded-section.html" .RelPermalink) -}}
      {{- $cat := . -}}
      {{- $secSlug := partial "menu/section-slug.html" $cat -}}
      {{- if and (ne $secSlug "promotions") (ne .Section "weekly-promotions") (ne .Section "content") -}}
        {{- range $cat.RegularPages -}}
          {{- $menuItems = $menuItems | append (partial "menu/item-dict.html" (dict "page" . "sectionSlug" $secSlug "locationSlug" "" "category" $cat)) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $json := dict
    "menu_items" $menuItems
    "total_count" (len $menuItems)
    "multi_location_menus" $multi
    "generated_at" now
-}}

{{ $json | jsonify }}
