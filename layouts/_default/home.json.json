{{ warnf "Generating JSON file for Home Page: %s" .Title }}
{{- with .Site.Home }}

  {{- $images := slice -}}
  {{- range .Params.images }}
    {{- $images = $images | append (dict "image" .image) -}}
  {{- end }}

  {{- $slideshowImages := slice -}}
  {{- range .Params.slideshow }}
    {{- $slideshowImages = $slideshowImages | append (dict "image" .image) -}}
  {{- end }}

  {{- $locations := slice -}}
  {{- with site.Data.locations.locations }}
    {{- range . }}
      {{- $locationData := dict
          "address"  .address
          "city"     .city
          "island"   .island
          "subcategories"  .subcategories
          "orderingtables" .orderingtables
          "latlon"    .latlon
          "phone"    .phone
          "whatsapp" .whatsapp
          "delivery" .delivery
          "opening_hours" .opening_hours
        -}}
      {{- $locations = $locations | append $locationData -}}
    {{- end }}
  {{- end }}

  {{- $social := dict -}}
  {{- with site.Params.social -}}
    {{- with .facebook }}{{ $social = merge $social (dict "facebook" .) }}{{ end }}
    {{- with .instagram }}{{ $social = merge $social (dict "instagram" .) }}{{ end }}
    {{- with .youtube }}{{ $social = merge $social (dict "youtube" .) }}{{ end }}
    {{- with .tiktok }}{{ $social = merge $social (dict "tiktok" .) }}{{ end }}
    {{- with .email }}{{ $social = merge $social (dict "email" .) }}{{ end }}
    {{- with .phone }}{{ $social = merge $social (dict "phone" .) }}{{ end }}
  {{- end -}}
  {{- with .Params.facebook }}{{ $social = merge $social (dict "facebook" .) }}{{ end }}
  {{- with .Params.instagram }}{{ $social = merge $social (dict "instagram" .) }}{{ end }}
  {{- with .Params.youtube }}{{ $social = merge $social (dict "youtube" .) }}{{ end }}
  {{- with .Params.tiktok }}{{ $social = merge $social (dict "tiktok" .) }}{{ end }}

  {{- /* Plan matrix (CPS hugoPlanConfigReplacements):
       free (unverified): menu app, search, unbranded pin, ordering locked, directions, social links
       free_verified: WhatsApp ordering, branded pin, ordering unlocked, notifications
       tier1 / tier1_4mo: analytics + Loyverse (+ verified)
       tier2: featured (+ tier1)
  */ -}}
  {{- $f := site.Params.features | default dict -}}
  {{- /* Add-ons: feature flag + service enabled (plan matrix does not flip these). */ -}}
  {{- $paySvc := site.Params.paymentService | default dict -}}
  {{- $delSvc := site.Params.deliveryService | default dict -}}
  {{- $payments := and (default false $f.payments) (default false $paySvc.enabled) -}}
  {{- $delivery := and (default false $f.delivery) (default false $delSvc.enabled) -}}
  {{- $notifications := default false $f.notifications -}}
  {{- $analytics := or (default false $f.analytics_access) (default false $f.analytics) -}}
  {{- $loyverseConnect := default false $f.loyverse_connect -}}
  {{- $featured := default false $f.featured -}}
  {{- $exclusiveAds := default false $f.exclusive_ads -}}
  {{- if not $exclusiveAds -}}{{- $exclusiveAds = default false $f.no_competitor_ads -}}{{- end -}}

  {{- $pos := false -}}
  {{- $posProvider := "" -}}
  {{- with site.Params.posintegration -}}
    {{- if and $loyverseConnect .enabled -}}
      {{- $pos = true -}}
      {{- with .provider -}}{{- $posProvider = . -}}{{- end -}}
    {{- end -}}
  {{- end -}}

  {{- $tier := lower (default "free" site.Params.tier) -}}
  {{- /* Only Free unverified uses unbranded pin / free_menu hub treatment */ -}}
  {{- $freeMenu := eq $tier "free" -}}
  {{- $brandedPin := not $freeMenu -}}
  {{- $orderingEnabled := false -}}
  {{- with site.Params.orderingsystem -}}
    {{- $orderingEnabled = default false .enabled -}}
  {{- end -}}

  {{- $features := dict
      "payments" $payments
      "delivery" $delivery
      "notifications" $notifications
      "ordering" $orderingEnabled
      "pos" $pos
      "loyverse_connect" $loyverseConnect
      "analytics" $analytics
      "analytics_access" $analytics
      "exclusive_ads" $exclusiveAds
      "featured" $featured
      "no_competitor_ads" (default false $f.no_competitor_ads)
      "unmetered_traffic" (default false $f.unmetered_traffic)
      "branded_pin" $brandedPin
  -}}
  {{- if and $pos (ne (strings.TrimSpace $posProvider) "") -}}
    {{- $features = merge $features (dict "pos_provider" (lower (strings.TrimSpace $posProvider))) -}}
  {{- end -}}

  {{- $mappin := dict -}}
  {{- if $brandedPin -}}
    {{- $mappin = site.Data.mappin | default dict -}}
  {{- end -}}
  {{- $clientID := site.Params.contentManagement.clientId | default site.Params.ads.clientId | default "" -}}
  {{- $logo := "/branding/favicon144.webp" -}}

  {{- $json := dict
      "title" .Title
      "client_id" $clientID
      "logo" $logo
      "tier" $tier
      "free_menu" $freeMenu
      "paid_menu" (not $freeMenu)
      "hero_background_image" (.Params.image | default "")
      "featured_images" $images
      "slideshow" $slideshowImages
      "client_tour_images" $slideshowImages
      "locations" $locations
      "social_links" $social
      "features" $features
      "categories"  (.Params.categories | default "")
      "tags" (.Params.tags | default slice)
      "type" (.Params.type | default slice)
      "content" (.Content | default "")
      "mappin" $mappin
  -}}

  {{ $json | jsonify }}

{{- end }}
